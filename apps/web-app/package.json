{
  "name": "web-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "generate:sitemap": "node scripts/generate-sitemap.js",
    "prerender:seo": "node scripts/prerender-routes.js",
    "prebuild": "npm run generate:sitemap",
    "verify:seo": "node scripts/verify-seo-assets.js --require-hosted-url",
    "verify:docs": "node scripts/verify-docs.js",
    "build": "npm run typecheck && vite build && npm run prerender:seo && npm run verify:docs",
    "lint": "eslint src --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.node.json --noEmit",
    "build:plugin-ui": "vite build --config vite.plugin.config.ts"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/outfit": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@supabase/supabase-js": "^2.117.2",
    "@vercel/analytics": "^2.0.1",
    "ajv": "^8.20.0",
    "github-markdown-css": "^5.9.0",
    "highlight.js": "^11.12.0",
    "react": "^19.2.8",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "react-router": "^8.4.0",
    "react-virtuoso": "^4.18.16",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "sanitize-filename": "^1.6.4",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.2.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^5.0.3",
    "autoprefixer": "^10.6.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "express-rate-limit": "^8.5.2",
    "globals": "^17.12.0",
    "jsdom": "^30.1.1",
    "postcss": "8.5.28",
    "tailwindcss": "^4.2.0",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.0",
    "@modelcontextprotocol/ext-apps": "2.0.3",
    "vite-plugin-singlefile": "2.3.3"
  },
  "overrides": {
    "brace-expansion": "^5.0.12",
    "fast-uri": "^3.1.8",
    "flatted": "^3.4.0",
    "ip-address": "^10.7.1"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  }
}
