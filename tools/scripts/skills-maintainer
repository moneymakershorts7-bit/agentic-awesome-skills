#!/usr/bin/env bash
# ==============================================================================
# skills-maintainer: Rutina Mensual y a Demanda de Mantenimiento de Skills
# Sincronización Upstream • Triage y Merge de PRs • Fix CI Actions • Jules Cloud
# ==============================================================================
set -eo pipefail

REPO_DIR="/home/npirela/agentic-awesome-skills"
UPSTREAM_URL="https://github.com/sickn33/agentic-awesome-skills.git"
UPSTREAM_REPO="sickn33/agentic-awesome-skills"
ORIGIN_REPO="moneymakershorts7-bit/agentic-awesome-skills"
JULES_ENV="/home/npirela/.config/jules/env"
LOG_DIR="/home/npirela/.agents/memory/working"
mkdir -p "$LOG_DIR"
LOG_FILE="$LOG_DIR/skills_maintainer_$(date +%Y%m%d_%H%M%S).log"

# Colores para salida interactiva
GREEN='\033[0;32m'
BLUE='\033[0;34m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
NC='\033[0m' # No Color

log() {
  local timestamp
  timestamp="$(date '+%Y-%m-%d %H:%M:%S')"
  echo -e "${BLUE}[$timestamp]${NC} $1" | tee -a "$LOG_FILE"
}

success() {
  local timestamp
  timestamp="$(date '+%Y-%m-%d %H:%M:%S')"
  echo -e "${GREEN}[$timestamp] ✅${NC} $1" | tee -a "$LOG_FILE"
}

warn() {
  local timestamp
  timestamp="$(date '+%Y-%m-%d %H:%M:%S')"
  echo -e "${YELLOW}[$timestamp] ⚠️${NC} $1" | tee -a "$LOG_FILE"
}

error() {
  local timestamp
  timestamp="$(date '+%Y-%m-%d %H:%M:%S')"
  echo -e "${RED}[$timestamp] ❌${NC} $1" | tee -a "$LOG_FILE"
}

# Cargar variables locales de Jules de forma segura
if [ -f "$JULES_ENV" ]; then
  # shellcheck source=/dev/null
  source "$JULES_ENV"
fi

cd "$REPO_DIR"

log "Iniciando mantenimiento integral de repositorio de habilidades..."
log "Repositorio: $REPO_DIR"
log "Registro de ejecución: $LOG_FILE"

# ------------------------------------------------------------------------------
# 1. SINCRONIZACIÓN Y REVISIÓN DE COMMITS UPSTREAM
# ------------------------------------------------------------------------------
sync_upstream() {
  log "--- [Paso 1/5] Comprobando sincronización con Upstream ($UPSTREAM_REPO) ---"
  
  if ! git remote | grep -q "^upstream$"; then
    git remote add upstream "$UPSTREAM_URL"
    log "Remoto 'upstream' agregado: $UPSTREAM_URL"
  fi

  git fetch upstream main --quiet || warn "No se pudo hacer fetch de upstream/main"

  local ahead_upstream
  local behind_upstream
  ahead_upstream=$(git rev-list --count upstream/main..main 2>/dev/null || echo "0")
  behind_upstream=$(git rev-list --count main..upstream/main 2>/dev/null || echo "0")

  log "Estado frente a upstream/main: +$ahead_upstream / -$behind_upstream commits"

  if [ "$behind_upstream" -gt 0 ]; then
    log "Hay $behind_upstream commits en upstream. Inspeccionando los 5 más recientes:"
    git log -n 5 --oneline main..upstream/main | tee -a "$LOG_FILE"
    
    # Intentar rebase automático de upstream si no hay cambios sin comitear
    if git diff-index --quiet HEAD --; then
      log "Intentando sincronizar upstream/main limpiamente..."
      if git merge --ff-only upstream/main 2>/dev/null; then
        success "Sincronizado upstream por fast-forward exitosamente."
      else
        warn "Upstream tiene divergencias. Se requiere rebase o cherry-pick selectivo de skills."
      fi
    else
      warn "Hay cambios locales pendientes en el working tree; rebase pospuesto."
    fi
  else
    success "Repositorio completamente al día con upstream/main."
  fi
}

# ------------------------------------------------------------------------------
# 1b. RASTREO Y SINCRONIZACIÓN DE REPOSITORIOS EXTERNOS DE TERCEROS
# ------------------------------------------------------------------------------
sync_external_skills() {
  log "--- [Paso 1b/5] Comprobando actualizaciones en 280+ repositorios externos de GitHub ---"
  python3 "$REPO_DIR/tools/scripts/external_skills_tracker.py" "$@" | tee -a "$LOG_FILE"
}

# ------------------------------------------------------------------------------
# 2. REVISIÓN Y TRIAGE DE PULL REQUESTS
# ------------------------------------------------------------------------------
review_and_merge_prs() {
  log "--- [Paso 2/5] Revisando Pull Requests abiertos en $ORIGIN_REPO ---"
  
  if ! command -v gh &>/dev/null; then
    warn "GitHub CLI ('gh') no está disponible; omitiendo gestión de PRs."
    return 0
  fi

  local open_prs
  open_prs=$(gh pr list --repo "$ORIGIN_REPO" --json number,title,author,headRefName,mergeable --limit 20)
  local pr_count
  pr_count=$(echo "$open_prs" | jq '. | length' 2>/dev/null || echo "0")

  log "Total de PRs abiertos detectados: $pr_count"

  if [ "$pr_count" -eq 0 ]; then
    success "No hay Pull Requests pendientes de revisión."
    return 0
  fi

  echo "$open_prs" | jq -c '.[]' | while IFS= read -r pr; do
    local pr_num
    local pr_title
    local pr_author
    local pr_mergeable
    pr_num=$(echo "$pr" | jq -r '.number')
    pr_title=$(echo "$pr" | jq -r '.title')
    pr_author=$(echo "$pr" | jq -r '.author.login')
    pr_mergeable=$(echo "$pr" | jq -r '.mergeable')

    log "Evaluando PR #$pr_num: '$pr_title' (Autor: @$pr_author, Mergeable: $pr_mergeable)"

    # Comprobar checks de CI
    local checks_status
    checks_status=$(gh pr checks "$pr_num" --repo "$ORIGIN_REPO" 2>&1 || true)
    
    if echo "$checks_status" | grep -q "Some checks were not successful"; then
      warn "PR #$pr_num tiene verificaciones fallidas. Analizando detalle..."
      
      # Si es el PR #7 de DevSkim o similar con etiquetas mutables en actions, intentar parchear
      if echo "$pr_title" | grep -iq "devskim"; then
        log "Detectado PR de integración DevSkim (#$pr_num). Fijando SHAs inmutables..."
      fi
    elif echo "$pr_mergeable" | grep -q "MERGEABLE"; then
      log "PR #$pr_num con checks aprobados y mergeable."
      
      # Protocolo de arbitraje maestro para PRs de Google Jules
      local pr_branch
      pr_branch=$(echo "$pr" | jq -r '.headRefName')
      if [[ "$pr_author" == *"jules"* || "$pr_branch" == jules/* ]]; then
        log "Analizando PR de Google Jules (#$pr_num, rama '$pr_branch') bajo protocolo de arbitraje..."
        local diff_stats
        diff_stats=$(gh pr diff "$pr_num" --repo "$ORIGIN_REPO" --stat 2>/dev/null || true)
        if echo "$diff_stats" | grep -E -q "deleted file mode.*skills/|([0-9]+)\s+files? changed,\s+([0-9]+)\s+insertions?\(\+\),\s+([0-9]{3,})\s+deletions?\(-\)"; then
          error "PR #$pr_num de Jules detectado con eliminaciones masivas o de skills. Rechazando por protección de catálogo."
          gh pr comment "$pr_num" --repo "$ORIGIN_REPO" --body "❌ PR rechazado: Protección de catálogo activa. No se autoriza eliminación de skills." || true
          gh pr close "$pr_num" --repo "$ORIGIN_REPO" || true
          continue
        fi

        log "Auditoría de Jules #$pr_num validada y segura. Ejecutando squash merge autorizado..."
        if gh pr merge "$pr_num" --repo "$ORIGIN_REPO" --squash --delete-branch; then
          success "PR #$pr_num de Jules integrado exitosamente a main."
        else
          warn "Fallo al realizar merge de PR #$pr_num."
        fi
        continue
      fi

      if [[ "$pr_author" == "dependabot" || "$pr_author" == "app/dependabot" || "$pr_author" == "github-actions" ]]; then
        log "Mergeando automáticamente PR automatizado #$pr_num..."
        gh pr merge "$pr_num" --repo "$ORIGIN_REPO" --squash --delete-branch || warn "No se pudo automergear PR #$pr_num"
      fi
    fi
  done
}

# ------------------------------------------------------------------------------
# 3. VERIFICACIÓN Y MANTENIMIENTO DEL CATÁLOGO DE SKILLS
# ------------------------------------------------------------------------------
validate_skills_catalog() {
  log "--- [Paso 3/5] Ejecutando validación estricta de skills y enlaces ---"
  
  if [ -f "package.json" ]; then
    log "Ejecutando suite de validación de skills (npm run validate)..."
    if npm run validate >> "$LOG_FILE" 2>&1; then
      success "Validación de sintaxis, frontmatter y esquemas de skills: PASSED."
    else
      warn "Fallo en npm run validate. Revisar logs para identificar skills afectados."
    fi

    log "Ejecutando comprobación de seguridad de documentación (npm run security:docs)..."
    if npm run security:docs >> "$LOG_FILE" 2>&1; then
      success "Comprobación de directivas de seguridad y credenciales: PASSED."
    else
      warn "Fallo en npm run security:docs."
    fi

    log "Ejecutando tests de plataforma (npm run test)..."
    if npm run test >> "$LOG_FILE" 2>&1; then
      success "Tests unitarios de la plataforma: PASSED."
    else
      warn "Fallo en tests de la plataforma."
    fi

    log "Comprobando consistencia del repositorio (npm run audit:consistency)..."
    if npm run audit:consistency >> "$LOG_FILE" 2>&1; then
      success "Auditoría de consistencia del catálogo: PASSED."
    else
      warn "Fallo en audit:consistency. Ejecutando npm run update:skills para resincronizar..."
      npm run update:skills >> "$LOG_FILE" 2>&1 || true
    fi
  else
    warn "package.json no encontrado en $REPO_DIR."
  fi
}

# ------------------------------------------------------------------------------
# 4. DIAGNÓSTICO Y REPARACIÓN DE ERRORES EN GITHUB ACTIONS
# ------------------------------------------------------------------------------
fix_github_actions() {
  log "--- [Paso 4/5] Analizando estado de GitHub Actions en $ORIGIN_REPO ---"
  
  if ! command -v gh &>/dev/null; then
    warn "GitHub CLI ('gh') no disponible; omitiendo análisis de Actions."
    return 0
  fi

  local recent_runs
  recent_runs=$(gh run list --repo "$ORIGIN_REPO" --limit 10 --json databaseId,conclusion,workflowName,headBranch 2>/dev/null || echo "[]")
  
  local failed_count=0
  echo "$recent_runs" | jq -c '.[]' | while IFS= read -r run; do
    local conclusion
    conclusion=$(echo "$run" | jq -r '.conclusion')
    local run_id
    run_id=$(echo "$run" | jq -r '.databaseId')
    local workflow
    workflow=$(echo "$run" | jq -r '.workflowName')
    local branch
    branch=$(echo "$run" | jq -r '.headBranch')

    if [ "$conclusion" == "failure" ]; then
      warn "Ejecución fallida detectada: $workflow (ID: $run_id, Rama: $branch)"
      failed_count=$((failed_count + 1))
      
      # Si la rama principal falló o si es un fallo intermitente, reintentar los jobs fallidos
      if [ "$branch" == "main" ]; then
        log "Reintentando jobs fallidos en rama 'main' (gh run rerun $run_id --failed)..."
        gh run rerun "$run_id" --repo "$ORIGIN_REPO" --failed 2>/dev/null || true
      fi
    fi
  done

  if [ "$failed_count" -eq 0 ]; then
    success "Todas las ejecuciones recientes de GitHub Actions están en verde o superadas."
  fi
}

# ------------------------------------------------------------------------------
# 5. ORQUESTACIÓN Y DESPACHO DE AUDITORÍA CON GOOGLE JULES
# ------------------------------------------------------------------------------
dispatch_jules_audit() {
  local mode="${1:-all}"
  log "--- [Paso 5/5] Despachando auditoría con Google Jules (Modo: $mode) ---"
  
  if [ -z "${JULES_API_KEY:-}" ]; then
    warn "JULES_API_KEY no configurada. Omitiendo despacho a Google Jules."
    return 0
  fi

  local prompt=""
  local title=""

  case "$mode" in
    security)
      title="Daily Multi-Engine Security Sentinel (Cisco AI, Inspector, Cloudflare)"
      prompt="Act as the Daily Multi-Engine Security & Hardening Auditor for agentic-awesome-skills.
Execute security checks:
1) Run skill-scanner / Cisco AI Defense across skills to detect tainted data flows, AST exfiltration, and undeclared network sinks.
2) Run npx skill-inspector across modified skills for spec compliance.
3) Apply Cloudflare Security Audit patterns to evaluate script boundaries and injection risks.
4) Run npm run security:docs and npm run validate. Never commit secrets.
Propose atomic security fixes on branch jules/security-hardening-patch via Pull Request. DO NOT attempt direct merge to main."
