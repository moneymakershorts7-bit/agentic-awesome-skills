is_jules_cli_authenticated() {
  if ! command -v jules &>/dev/null; then
    return 1
  fi
  local check_out
  check_out=$(jules remote list --session 2>&1 || true)
  if [[ "$check_out" == *"did you forget to login"* || "$check_out" == *"failed to list"* || "$check_out" == *"without a valid client"* ]]; then
    return 1
  fi
  return 0
}

jules_remote_list() {
  local target="${1:---session}"
  if is_jules_cli_authenticated; then
    log "Consultando Jules en la nube vía Jules CLI (jules remote list $target)..."
    jules remote list "$target"
  else
    log "Jules CLI no autenticado vía OAuth. Consultando mediante Jules REST API v1alpha..."
    if [ -z "${JULES_API_KEY:-}" ]; then
      warn "Ni Jules CLI ni JULES_API_KEY están disponibles. Ejecuta 'jules login' o configura JULES_API_KEY."
      return 1
    fi
    if [[ "$target" == "--repo" || "$target" == "repo" || "$target" == "repos" ]]; then
      curl -s -H "x-goog-api-key: $JULES_API_KEY" https://jules.googleapis.com/v1alpha/sources | jq .
    else
      curl -s -H "x-goog-api-key: $JULES_API_KEY" https://jules.googleapis.com/v1alpha/sessions | jq .
    fi
  fi
}

jules_remote_pull() {
  local session_id="$1"
  shift || true
  if [ -z "$session_id" ]; then
    error "Uso: skills-maintainer jules pull <SESSION_ID> [--apply]"
    return 1
  fi
  if is_jules_cli_authenticated; then
    log "Descargando resultados de sesión Jules #$session_id vía Jules CLI..."
    jules remote pull --session "$session_id" "$@"
  else
    log "Jules CLI no autenticado. Consultando detalles de sesión #$session_id vía REST API..."
    if [ -z "${JULES_API_KEY:-}" ]; then
      error "JULES_API_KEY no configurada. Ejecuta 'jules login' o configura JULES_API_KEY."
      return 1
    fi
    curl -s -H "x-goog-api-key: $JULES_API_KEY" "https://jules.googleapis.com/v1alpha/sessions/$session_id" | jq .
  fi
}

dispatch_jules_task() {
  local prompt="$1"
  local title="${2:-Custom Jules Task}"
  local repo="${3:-$ORIGIN_REPO}"

  log "Despachando tarea a Google Jules: '$title'..."

  if is_jules_cli_authenticated; then
    log "Modo de Despacho: Jules CLI oficial ('jules remote new')..."
    if jules remote new --repo "$repo" --session "$prompt"; then
      success "Sesión iniciada con éxito en Google Jules mediante CLI!"
      return 0
    else
      warn "Fallo en 'jules remote new'. Intentando fallback a REST API v1alpha..."
    fi
  fi

  if [ -z "${JULES_API_KEY:-}" ]; then
    error "No se puede despachar a Jules: Jules CLI no autenticado y JULES_API_KEY no configurada."
    return 1
  fi

  log "Modo de Despacho: Jules REST API v1alpha ($JULES_API_KEY)..."
  local jules_response
  jules_response=$(curl -s -X POST https://jules.googleapis.com/v1alpha/sessions \
    -H "x-goog-api-key: $JULES_API_KEY" \
    -H "Content-Type: application/json" \
    -d "$(jq -n \
      --arg prompt "$prompt" \
      --arg title "$title" \
      --arg repo "sources/github/$repo" \
      '{
        prompt: $prompt,
        title: $title,
        sourceContext: {
          source: $repo,
          githubRepoContext: { startingBranch: "main" }
        }
      }')")

  local session_id
  session_id=$(echo "$jules_response" | jq -r '.id // empty' 2>/dev/null || true)
  local session_url
  session_url=$(echo "$jules_response" | jq -r '.url // empty' 2>/dev/null || true)

  if [ -n "$session_id" ]; then
    success "Sesión de Google Jules iniciada con éxito! ($title)"
    log "ID de Sesión: $session_id"
    log "URL de Seguimiento: $session_url"
  else
    warn "Respuesta de Jules: $jules_response"
  fi
}

# ------------------------------------------------------------------------------
# MODO DE EJECUCIÓN
# ------------------------------------------------------------------------------
case "${1:-all}" in
  upstream)
    sync_upstream
    ;;
  external|external-sync)
    sync_external_skills "${@:2}"
    ;;
  prs)
    review_and_merge_prs
    ;;
  validate)
    validate_skills_catalog
    ;;
  actions|ci)
    fix_github_actions
    if [[ "${2:-}" == "--fix" || "${2:-}" == "fix" ]]; then
      dispatch_jules_audit "ci-fix"
    fi
    ;;
  discovery)
    log "Iniciando explorador de skills y servidores MCP..."
    if [[ "${2:-}" == "jules" || "${2:-}" == "--jules" ]]; then
      dispatch_jules_audit "discovery"
    else
      python3 "$REPO_DIR/tools/scripts/discovery_scout.py" "${@:2}"
    fi
    ;;
  free-for-dev|free-tools|free-dev)
    log "Iniciando explorador e indexador de herramientas gratuitas (Free-For-Dev)..."
    if [[ "${2:-}" == "jules" || "${2:-}" == "--jules" ]]; then
      dispatch_jules_audit "free-for-dev"
    elif [[ "${2:-}" == "search" || "${2:-}" == "-s" ]]; then
      python3 "$REPO_DIR/tools/scripts/free_for_dev_indexer.py" --search "${3:-}" "${@:4}"
    elif [[ "${2:-}" == "recommend" || "${2:-}" == "-r" ]]; then
      python3 "$REPO_DIR/tools/scripts/free_for_dev_indexer.py" --recommend "${3:-}" "${@:4}"
    elif [[ "${2:-}" == "category" || "${2:-}" == "-c" ]]; then
      python3 "$REPO_DIR/tools/scripts/free_for_dev_indexer.py" --category "${3:-}" "${@:4}"
    elif [[ "${2:-}" == "stats" ]]; then
      python3 "$REPO_DIR/tools/scripts/free_for_dev_indexer.py" --stats
    elif [[ "${2:-}" == "update" || "${2:-}" == "--update" ]]; then
      python3 "$REPO_DIR/tools/scripts/free_for_dev_indexer.py" --update
    else
      python3 "$REPO_DIR/tools/scripts/free_for_dev_scout.py" --notify "${@:2}"
    fi
    ;;
  awesome|awesome-tools|awesome-scout)
    log "Iniciando explorador de GitHub Awesome Topics y herramientas FOSS por proyecto..."
    if [[ "${2:-}" == "jules" || "${2:-}" == "--jules" ]]; then
      dispatch_jules_audit "awesome"
    elif [[ "${2:-}" == "search" || "${2:-}" == "-s" ]]; then
      python3 "$REPO_DIR/tools/scripts/awesome_scout.py" --search "${3:-}" "${@:4}"
    elif [[ "${2:-}" == "recommend" || "${2:-}" == "-r" ]]; then
      python3 "$REPO_DIR/tools/scripts/awesome_scout.py" --recommend "${3:-}" "${@:4}"
    elif [[ "${2:-}" == "dry-run" || "${2:-}" == "--dry-run" ]]; then
      python3 "$REPO_DIR/tools/scripts/awesome_scout.py" --dry-run "${@:3}"
    else
      python3 "$REPO_DIR/tools/scripts/awesome_scout.py" "${@:2}"
    fi
    ;;
  review-discovery|review)
    log "Iniciando motor de revisión y triaje de candidatos descubiertos..."
    python3 "$REPO_DIR/tools/scripts/review_discovery.py" "${@:2}"
    ;;
  jules)
    case "${2:-all}" in
      version|-v|--version)
        if command -v jules &>/dev/null; then
          jules version
        else
          echo "Jules CLI (@google/jules) no encontrado en PATH."
        fi
        ;;
      list|ls)
        jules_remote_list "${3:---session}"
        ;;
      pull)
        jules_remote_pull "$3" "${@:4}"
        ;;
      new)
        dispatch_jules_task "$3" "Ad-hoc Jules CLI Task" "${4:-$ORIGIN_REPO}"
        ;;
      login)
        echo "Iniciando login guiado de Jules CLI..."
        jules login --no-launch-browser
        ;;
      security|docs|optimize|ci-fix|cifix|malware|threats|discovery|scout|free-for-dev|free-dev|awesome|awesome-tools|all)
        dispatch_jules_audit "$2"
        ;;
      *)
        dispatch_jules_audit "${2:-all}"
        ;;
    esac
    ;;
  malware)
    log "Ejecutando escáner local de malware y backdoors..."
    python3 "$REPO_DIR/tools/scripts/malware_scanner.py" --strict "$REPO_DIR"
    ;;
  all|--all)
    sync_upstream
    sync_external_skills --limit 30
    review_and_merge_prs
    validate_skills_catalog
    fix_github_actions
    log "Mostrando estado del dossier mensual de descubrimientos para triaje..."
    python3 "$REPO_DIR/tools/scripts/review_discovery.py" --dossier || true
    dispatch_jules_audit "all"
    success "Rutina mensual completada con éxito. Detalles en: $LOG_FILE"
    ;;
  -h|--help|help)
    echo "Uso: skills-maintainer [opción] [sub-opción]"
    echo ""
    echo "Opciones:"
    echo "  all                                         Ejecutar rutina mensual completa [Default]"
    echo "  upstream                                    Sincronizar e inspeccionar cambios de upstream/main"
    echo "  external [--check|--scan|--ingest|--limit N] Rastrear, comprobar o ingerir 560+ repositorios externos"
    echo "  prs                                         Revisar y arbitrar PRs (Protección anti-borrado y Dependabot)"
    echo "  awesome [--recommend|--search|--jules]      Explorar GitHub Awesome topics y proponer herramientas FOSS por proyecto"
    echo "  free-for-dev [--update|search|recommend]    Explorar, indexar y recomendar herramientas gratuitas de desarrollo"
    echo "  discovery [--jules|--dry-run|--limit N]     Explorar GitHub en busca de nuevos skills y MCPs (local o Jules)"
    echo "  review-discovery [--list|--audit|--accept]  Revisar y arbitrar candidatos descubiertos en el barrido mensual"
    echo "  validate                                    Ejecutar validadores de skills, seguridad de docs y tests"
    echo "  ci [--fix]                                  Inspeccionar y re-ejecutar CI fallido (o auto-fix con Jules)"
    echo "  malware                                     Ejecutar escaneo local de malware y amenazas de cadena de suministro"
    echo "  jules [awesome|free-for-dev|security|all]   Despachar auditoría/centinela específico a Google Jules"
    echo "  jules version                               Mostrar la versión del CLI oficial de Jules"
    echo "  jules list [--repo|--session]               Listar repositorios o sesiones remotas activas de Jules"
    echo "  jules pull <session_id> [--apply]           Descargar o inspeccionar el diff de una sesión de Jules"
    echo "  jules new \"<prompt>\" [repo]                 Crear una sesión ad-hoc en Jules"
    echo "  jules login                                 Autenticar Jules CLI mediante flujo headless"
    echo "  --help                                      Mostrar esta ayuda"
    exit 0
    ;;
  *)
    error "Opción no reconocida: $1. Usa 'skills-maintainer --help' para ver opciones."
    exit 1
    ;;
esac
